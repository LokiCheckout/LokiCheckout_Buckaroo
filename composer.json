{
    "name": "loki-checkout/magento2-buckaroo",
    "version": "3.0.2",
    "description": "Compatibility module for the Buckaroo payment solution",
    "keywords": [
        "loki-checkout",
        "loki-checkout-category-payment"
    ],
    "homepage": "https://loki-checkout.com/",
    "authors": [
        {
            "name": "Jisse Reitsma (Yireo)",
            "email": "jisse@yireo.com"
        }
    ],
    "type": "magento2-module",
    "require": {
        "buckaroo/magento2": "^2.4",
        "ext-json": "*",
        "ext-pcre": "*",
        "loki-checkout/magento2-core": "^2.0",
        "loki/magento2-components": "^2.0",
        "loki/magento2-css-utils": "^1.0",
        "loki/magento2-field-components": "^2.0",
        "magento/framework": "^103.0",
        "magento/module-quote": "^101.0",
        "magento/module-store": "^101.0",
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "yireo/magento2-integration-test-helper": "~0.0"
    },
    "license": "OSL-3.0",
    "autoload": {
