<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.payment.methods.buckaroo_magento2_paybybank.form"
            template="LokiCheckout_Core::generic/container.phtml">
            <arguments>
                <argument name="css_classes" xsi:type="array">
                    <item name="block" xsi:type="array">
                        <item name="default" xsi:type="string">my-4</item>
                    </item>
                </argument>
            </arguments>

            <block
                name="loki-checkout.payment.methods.buckaroo_magento2_paybybank.form.issuer" as="issuer"
                template="LokiCheckout_Buckaroo::checkout/payment/method/paybybank.phtml"
            >
                <arguments>
                    <argument name="required_error_message" xsi:type="string">Please select your bank</argument>
                </arguments>
            </block>
        </block>
    </body>
</page>
