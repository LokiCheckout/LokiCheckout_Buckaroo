<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.payment.methods.buckaroo_magento2_afterpay20.form"
            template="LokiCheckout_Core::generic/container.phtml">
            <arguments>
                <argument name="css_classes" xsi:type="array">
                    <item name="block" xsi:type="array">
                        <item name="default" xsi:type="string">my-4</item>
                    </item>
                </argument>
            </arguments>

            <block
                name="loki-checkout.payment.methods.buckaroo_magento2_afterpay20.form.customer_identificationNumber" as="customer_identificationNumber"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_label" xsi:type="string">Identification number</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.payment.methods.buckaroo_magento2_afterpay20.form.customer_telephone" as="customer_telephone"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_label" xsi:type="string">Phone</argument>
                    <argument name="required_error_message" xsi:type="string">Please enter a valid phone number</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.payment.methods.buckaroo_magento2_afterpay20.form.customer_DoB" as="customer_DoB"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_label" xsi:type="string">Date of Birth</argument>
                    <argument name="minimum_age" xsi:type="number">18</argument>
                    <argument name="input_type" xsi:type="string">date</argument>
                    <argument name="required_error_message" xsi:type="string">Please enter a valid date of birth</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.payment.methods.buckaroo_magento2_afterpay20.form.customer_coc" as="customer_coc"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_label" xsi:type="string">COC Number</argument>
                    <argument name="required_error_message" xsi:type="string">Please enter a valid CoC number</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.payment.methods.buckaroo_magento2_afterpay20.form.termsCondition" as="termsCondition"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_label" xsi:type="string">Terms and Conditions</argument>
                    <argument name="field_type" xsi:type="string">checkbox</argument>
                    <argument name="required_error_message" xsi:type="string">Please agree to these terms</argument>
                </arguments>
            </block>
        </block>
    </body>
</page>
