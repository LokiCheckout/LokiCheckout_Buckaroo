<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.payment.methods.buckaroo_magento2_payperemail.form"
            template="LokiCheckout_Core::generic/container.phtml">
            <arguments>
                <argument name="css_classes" xsi:type="array">
                    <item name="block" xsi:type="array">
                        <item name="default" xsi:type="string">my-4</item>
                    </item>
                </argument>
            </arguments>

            <block
                name="loki-checkout.payment.methods.buckaroo_magento2_payperemail.form.customer_gender" as="customer_gender"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_label" xsi:type="string">Gender</argument>
                    <argument name="field_type" xsi:type="string">select</argument>
                    <argument name="option_model" xsi:type="object">LokiCheckout\Buckaroo\ViewModel\OptionModel\GenderOptionModel</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.payment.methods.buckaroo_magento2_payperemail.form.customer_email" as="customer_email"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_label" xsi:type="string">Email</argument>
                    <argument name="input_type" xsi:type="string">email</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.payment.methods.buckaroo_magento2_payperemail.form.customer_billingFirstName" as="customer_billingFirstName"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_label" xsi:type="string">First name</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.payment.methods.buckaroo_magento2_payperemail.form.customer_billingMiddleName" as="customer_billingMiddleName"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="required" xsi:type="boolean">false</argument>
                    <argument name="field_label" xsi:type="string">Middle name</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.payment.methods.buckaroo_magento2_payperemail.form.customer_billingLastName" as="customer_billingLastName"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_label" xsi:type="string">Last name</argument>
                </arguments>
            </block>
        </block>
    </body>
</page>
